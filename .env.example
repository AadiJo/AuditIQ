# AuditIQ reads this file from the repository root in development, and docker compose
# reads it too. Everything else (Jira, AI provider, watcher) is set in the app's Settings.

# Where people reach AuditIQ. Used for sign-in cookies and invite links.
# BASE_URL=https://auditiq.example.com

# Where the database, uploaded contracts, and CLI logins live. Back this directory up.
# DATA_DIR=.data

# Listen address. Keep 127.0.0.1 unless a reverse proxy or container needs otherwise.
# HOST=127.0.0.1
# PORT=5180

# Encrypts stored secrets and signs sessions. Generated into DATA_DIR on first start when unset.
# Changing it makes stored Jira and API keys unreadable until they are entered again.
# AUDITIQ_SECRET=

# Fallback credentials, used only when this machine has no `claude` or `codex` CLI login.
# They can also be entered in Settings, where they are stored encrypted.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# How often to check Jira for status changes and @AuditIQ mentions, in seconds.
# JIRA_POLL_SECONDS=60

# Largest contract upload, in megabytes.
# MAX_UPLOAD_MB=25
